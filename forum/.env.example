# 复制为 .env 后按需修改；不写也有一份能直接跑通的默认值。

# 监听地址。本机开发用 127.0.0.1；放到服务器上对外提供服务改成 0.0.0.0
HOST=127.0.0.1
PORT=3210

# 站点信息
SITE_NAME=方块盒子论坛
SITE_DESC=方块盒子官方玩家社区：使用求助、玩法分享、插件开发与建议反馈

# 数据与上传文件目录（相对路径基于本工程根目录）
DB_PATH=data/forum.db
UPLOAD_DIR=data/uploads

# 对外访问地址，用于生成分享链接、判断跨域。
# 部署到服务器后改成 https://forum.blockbox.cc.cd 这样
PUBLIC_ORIGIN=http://127.0.0.1:3210

# 允许发帖/注册的前端来源（跨域时用，逗号分隔）。论坛页面由本服务自己提供时留空即可
ALLOWED_ORIGINS=

# 登录状态保持天数
SESSION_DAYS=30

# 是否开放注册（0 表示只能由管理员建号）
REGISTER_OPEN=1

# 是否在反向代理（Nginx / Caddy）后面，开启后按 X-Forwarded-For 取真实 IP
TRUST_PROXY=0

# Cookie 只走 HTTPS。通过 https 访问时建议开启
SECURE_COOKIE=0

# 是否打印每条请求的访问日志
LOG_REQUESTS=1

# 访问统计（管理后台的浏览量 / 日活 / 月活）
# VISIT_TRACKING=0 可整体关掉；明细保留天数决定能回看多久的趋势
VISIT_TRACKING=1
VISIT_RETENTION_DAYS=400
# 访客指纹用的盐，换掉以后老访客会被当成新访客，一般不用改
VISIT_SALT=blockbox-forum

# 内容大小限制
MAX_BODY_BYTES=262144
MAX_AVATAR_BYTES=524288
MAX_COVER_BYTES=3145728
MAX_IMAGE_BYTES=4194304

# 图片长边上限：帖子配图 / 个人主页封面
MAX_IMAGE_DIMENSION=2560
MAX_COVER_DIMENSION=1920
THUMB_SIZE=520
AVATAR_SIZE=256

# 首次启动时自动创建的管理员（密码留空则不创建）。
# 已经有管理员后这两项就不再起作用
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASS=

# 邮件发送（账号设置里验证邮箱用）。SMTP_HOST 留空表示不发邮件，相关接口会提示未配置
#
# 方式一：外部邮箱服务，以 QQ 邮箱为例（SMTP_PASS 填「授权码」，不是登录密码）
#   SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_SECURE=1 SMTP_USER=xxx@qq.com MAIL_FROM=xxx@qq.com
#
# 方式二：自托管 Postfix（论坛服务器本机发信，发件人用自己的域名），详见 docs/部署.md：
#   SMTP_HOST=127.0.0.1 SMTP_PORT=25 SMTP_SECURE=0 SMTP_USER= SMTP_PASS= MAIL_FROM=noreply@你的域名
SMTP_HOST=
SMTP_PORT=465
# 465 端口保持 1（隐式 TLS）；587 端口或本机 Postfix 的 25 端口改成 0（自动升级 STARTTLS）
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
# 发件人显示地址；自托管 Postfix 时就是你的域名邮箱
MAIL_FROM=
# 外部 SMTP 服务器用自签名证书时设 1（连本机 Postfix 不用配，自动信任）
SMTP_ALLOW_SELF_SIGNED=0
