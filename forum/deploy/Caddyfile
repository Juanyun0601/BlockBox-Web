# Caddy 自动申请 HTTPS 证书，配置比 Nginx 短很多
# 把 forum.blockbox.cc.cd 解析到本机后，改一下域名即可
forum.blockbox.cc.cd {
	encode gzip

	# 反向代理到论坛进程
	reverse_proxy 127.0.0.1:3210 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# 请求体上限按最大的那一类上传给：图片 4 MB、插件包 20 MB，
	# 最大的是后台上传的安装包（.env 的 MAX_RELEASE_FILE_BYTES，默认 300 MB），
	# 所以这里给 320MB 留余量；只按图片的 5 MB 配会让传安装包报 413。
	request_body {
		max_size 320MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
